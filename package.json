{
  "name": "armis-workshop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ARMIS City V2 - spatial operating campus, provider supply, owner controls and Hermes conversation contracts.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "postbuild": "node scripts/stamp-build.mjs",
    "serve:live": "node server/cli.ts",
    "deploy:mac": "node scripts/deploy-mac.mjs",
    "test:runtime": "node --test scripts/owner-policy.test.mjs scripts/runtime-http.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mac": "node scripts/check-mac-connection.mjs",
    "test:deployment": "node --test scripts/check-mac-connection.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:runtime && npm run test:deployment && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22"
  }
}
